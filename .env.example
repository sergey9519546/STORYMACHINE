# ── AI Provider Configuration ────────────────────────────────────────────────
# StoryMachine supports FREE (OpenRouter) and PREMIUM (Gemini) AI providers.
# Set at least ONE of OPENROUTER_API_KEY or GEMINI_API_KEY to enable AI features.

# OPENROUTER_API_KEY: FREE AI Provider (Recommended for new users)
# Get a free API key at https://openrouter.ai/keys (no credit card required)
# Provides access to 30+ free models from Google, Meta, Mistral, and more
# with automatic failover when rate limits are hit. Priority: uses this first if set.
OPENROUTER_API_KEY="sk-or-v1-..."

# GEMINI_API_KEY: PREMIUM AI Provider (Optional)
# Google Gemini 2.0 Flash/Pro models for higher quality and longer context.
# The server boots WITHOUT this into analysis-only mode (doctor, diagnose, etc.).
# Only required to enable AI-backed features if OPENROUTER_API_KEY is not set.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server-only generation prompt kill switch. Static craft guidance is enabled
# by default; set to 1 (or true) to omit it. This is not exposed to clients.
# STORYMACHINE_DISABLE_CRAFT_SPEC=1

# STORYMACHINE_LOG_WRITER_CONTENT: default OFF (unset). On a parse failure or
# AI error, server/engine/** (the Labs-only generative simulation surface)
# logs what CHARACTERISES the failure — length, a non-reversible hash prefix,
# the model/label, the parser's own error — never the writer's actual text or
# a character's actual name. Set to 1 (or true) to have this deployment's own
# logs additionally carry the raw text on those parse-failure branches, for
# debugging a stubborn one. LOGS WRITER CONTENT — do not enable this on any
# deployment holding other people's scripts.
# STORYMACHINE_LOG_WRITER_CONTENT=1

# ── Multi-provider AI config (all optional — defaults to FreeRide or Gemini) ──

# Text LLM provider (legacy multi-provider system)
# AI_PROVIDER=gemini                        # or openai-compat
# AI_BASE_URL=https://openrouter.ai/api/v1  # required for openai-compat
# AI_API_KEY=sk-...                         # OPTIONAL for local servers (see below)
# AI_MODEL=google/gemini-2.5-pro            # model override (pro tier)
# AI_FAST_MODEL=google/gemini-2.5-flash     # model override (fast tier)

# ── Test generation with NO paid API key ─────────────────────────────────────
# Any OpenAI-compatible server works — including a keyless LOCAL model. The key
# is optional: local servers ignore it, so leave AI_API_KEY unset for them.
# See docs/LOCAL_AI_TESTING.md for the full walkthrough.
#
# 1) Local (Ollama — truly free, offline, no key):
#      ollama serve && ollama pull llama3.2
#    AI_PROVIDER=openai-compat
#    AI_BASE_URL=http://localhost:11434/v1
#    AI_MODEL=llama3.2
#    AI_ALLOW_PRIVATE_NETWORK_TARGETS=true   # only needed if NODE_ENV=production
#
# 2) Local (LM Studio — start its local server, then):
#    AI_PROVIDER=openai-compat
#    AI_BASE_URL=http://localhost:1234/v1
#    AI_MODEL=<the model id shown in LM Studio>
#
# 3) Free web tier (OpenRouter — needs a FREE key, not a paid one):
#    AI_PROVIDER=openai-compat
#    AI_BASE_URL=https://openrouter.ai/api/v1
#    AI_API_KEY=<free key from openrouter.ai/keys>
#    AI_MODEL=meta-llama/llama-3.2-3b-instruct:free

# ── Additional Premium Providers (Phase 2 - not yet implemented) ──────────────
# OpenAI (GPT-4, GPT-4o) - Get at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Anthropic (Claude 3.5) - Get at: https://console.anthropic.com/account/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Image provider (defaults to AI_PROVIDER; "none" disables image generation)
# AI_IMG_PROVIDER=gemini                    # or openai-compat or none
# AI_IMG_BASE_URL=https://api.openai.com/v1
# AI_IMG_API_KEY=sk-...
# AI_IMG_MODEL=dall-e-3

# TTS provider (defaults to AI_PROVIDER; "none" disables TTS)
# AI_TTS_PROVIDER=gemini                    # or openai-compat or none
# AI_TTS_BASE_URL=https://api.openai.com/v1
# AI_TTS_API_KEY=sk-...
# AI_TTS_MODEL=tts-1
# AI_TTS_VOICE=alloy

# Embedding provider (defaults to gemini — used for semantic belief detection)
# AI_EMBEDDING_PROVIDER=gemini              # or openai-compat or none
# AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AI_EMBEDDING_API_KEY=sk-...
# AI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini-specific model overrides (used when AI_PROVIDER=gemini)
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_FAST_MODEL=gemini-2.5-flash
# GEMINI_IMG_MODEL=gemini-2.5-flash-preview-image-generation
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TEMPERATURE=1.0

# Per-task model tier + cost overrides (advanced, all optional)
# AI_TASK_TIER_CANDIDATE=pro             # override one task's tier: fast|pro
#                                        # (task names: OUTLINE, CANDIDATE, REVISION,
#                                        # WORLDBUILD, DIALOGUE, ANALYSIS, ...)
# AI_COST_INPUT_PER_M=0.075              # USD per 1M prompt tokens, for cost estimation
# AI_COST_OUTPUT_PER_M=0.30              # USD per 1M output tokens, for cost estimation

# ── Collaboration (all optional) ─────────────────────────────────────────────
# COLLAB_SECRET=some-long-random-string  # HMAC secret signing collab room tokens.
#                                        # Set this in any deployment with more than
#                                        # one server process (or restarts) — unset
#                                        # falls back to a per-process random secret,
#                                        # so tokens stop validating across restarts.
#                                        # REQUIRED in production: POST /api/collab/token
#                                        # returns 503 if NODE_ENV=production and this is unset.
# COLLAB_MAX_ROOMS=200                   # Max concurrent Yjs collab rooms (default: 200)
# COLLAB_MAX_FRAME_BYTES=2097152         # Max WebSocket frame size for a collab connection, in
#                                        # bytes (default: 2097152 = 2 MiB, bounded 1024-100MiB).
#                                        # A frame over this size closes the connection with code
#                                        # 1009 (server/collab/yjs-server.ts).

# ── Security (all optional) ──────────────────────────────────────────────────
# METRICS_TOKEN=some-long-random-string  # When set, GET /metrics requires
#                                        # `Authorization: Bearer <token>` (404 otherwise).
#                                        # UNSET (default): /metrics is loopback-only
#                                        # (127.0.0.1/::1) — it exposes token usage and
#                                        # cost estimates, so never expose it to the internet
#                                        # without setting this. /health stays open.
# ADMIN_TOKEN=some-long-random-string    # When set, POST /api/ai-config and POST
#                                        # /api/ai-config/test require `Authorization:
#                                        # Bearer <token>` (401 otherwise), from EVERY
#                                        # caller including loopback. UNSET (default):
#                                        # these routes are loopback-only (127.0.0.1/::1)
#                                        # — without this, any remote caller could rewrite
#                                        # the server's AI provider config. GET /api/ai-config
#                                        # stays open (booleans only, no key material).
# AI_ALLOW_PRIVATE_NETWORK_TARGETS=true  # Opt-in to allow AI provider baseURLs pointing at
#                                        # loopback/private-network hosts (self-hosted Ollama,
#                                        # LM Studio). Default (unset): in production, provider
#                                        # URLs resolving to private/loopback/link-local ranges
#                                        # are rejected as SSRF. Leave unset unless you run a
#                                        # local model server.

# ── Server config (all optional) ─────────────────────────────────────────────
# PORT=3000                              # HTTP port (default: 3000)
# NODE_ENV=production                    # Set to production to serve pre-built frontend from ./dist
# TRUST_PROXY=1                          # Trust the first hop's X-Forwarded-For (set when a
#                                        # reverse proxy/load balancer terminates in front of this
#                                        # process — otherwise rate limiting and req.ip collapse
#                                        # onto the proxy's own IP). Also accepts a hop count, an
#                                        # IP/CIDR, or 'loopback' (Express's `trust proxy` values).
#                                        # Unset (default): no trust-proxy config applied.
# SHUTDOWN_DRAIN_MS=35000                # Delays server.close() by this many ms AFTER GET /ready
#                                        # has already flipped to 503 {reason:"draining"} on
#                                        # SIGTERM/SIGINT/an uncaught exception. Unset (default 0):
#                                        # today's timing — draining and server.close() happen in
#                                        # the SAME tick, so only a caller reusing an already-open
#                                        # keep-alive connection sees the 503; a fresh-connection
#                                        # prober (most healthchecks, including this repo's own
#                                        # wget-based one) gets ECONNREFUSED instead, measured at
#                                        # ~6ms after the signal. Set above your healthcheck's poll
#                                        # interval (docker-compose.yml uses 35000, past its own
#                                        # 30s interval) so a fresh-connection prober gets a real
#                                        # chance to land inside the window and see the 503 before
#                                        # the socket ever refuses it. CONSTRAINT: this value plus
#                                        # the app's own 10s hard-kill timer must stay BELOW your
#                                        # orchestrator's termination grace period (docker/docker
#                                        # compose stop default 10s via stop_grace_period;
#                                        # Kubernetes terminationGracePeriodSeconds default 30s) —
#                                        # the runtime SIGKILLs at ITS deadline regardless, which
#                                        # skips server.close()'s SQLite WAL flush entirely and
#                                        # always exits 137 instead of this app's own 0/1. See
#                                        # docker-compose.yml's stop_grace_period for a worked
#                                        # example (raise both together).

# ── Session persistence (all optional) ───────────────────────────────────────
# MAX_SESSIONS=100                       # Max concurrent in-memory sessions (default: 100)
# SESSION_DB_DIR=data/sessions           # Directory for per-session SQLite files (default:
#                                        # ./data/sessions). Set to :memory: to disable disk
#                                        # persistence entirely (ephemeral sessions only).
# SESSION_IDLE_TTL_MINUTES=1440          # Minutes of inactivity before a session is evicted from
#                                        # memory (default: 1440 = 24h). Lower on memory-constrained
#                                        # deployments; PERSIST mode re-hydrates from disk regardless.
# SESSION_FILE_TTL_HOURS=168             # Hours before orphaned session DB files are deleted (default: 168 = 7 days)

# ── Concurrency limits (all optional) ────────────────────────────────────────
# MAX_ROOMS=50                           # Process-wide cap on concurrently reserved room
#                                        # simulations across every session (default: 50).
#                                        # A new reservation past the cap gets a 429 rather
#                                        # than an unbounded queue.
# DOCTOR_WORKER_POOL=off                 # Force Script Doctor analysis back onto the main
#                                        # thread (the permanent in-process fallback).
#                                        # Unset (default): the worker pool is used.
# DOCTOR_WORKER_POOL_SIZE=2              # Override the auto-sized 1-2 worker threads
#                                        # (values above 4 are clamped to 4).
# DOCTOR_POOL_PREWARM=0                  # Set to 0 to skip the boot-time pre-warm (the server
#                                        # normally spawns the doctor worker pool's threads right
#                                        # after listen and runs one throwaway analysis through
#                                        # each, so the first real request skips the ~460-540ms
#                                        # worker cold start). Fire-and-forget; unset (default) is
#                                        # correct for normal deployments. Already a no-op under
#                                        # NODE_ENV=test. GET /ready reports when this has
#                                        # finished — point an orchestrator's readiness probe
#                                        # there (see the Dockerfile/docker-compose.yml
#                                        # HEALTHCHECK) instead of delaying boot with the flag
#                                        # below.
# DOCTOR_POOL_PREWARM_BEFORE_LISTEN=1    # Opposite trade from GET /ready: AWAIT the pre-warm
#                                        # above BEFORE the port opens at all, instead of firing
#                                        # it fire-and-forget once listen succeeds. The process
#                                        # takes ~2-3s longer to become reachable; in exchange no
#                                        # request can ever land during the warm-up window,
#                                        # useful for a single-process deployment with no
#                                        # readiness-aware load balancer in front of it (a bare
#                                        # `docker run`, a local `npm start`). Unset (default):
#                                        # off — same fire-and-forget boot as before this flag
#                                        # existed. Ignored (no-op) when DOCTOR_POOL_PREWARM=0 or
#                                        # NODE_ENV=test, same as the pre-warm itself.
# DOCTOR_POOL_PREWARM_TIMEOUT_MS=30000   # Deadline on the pre-warm above: if every warm-up job
#                                        # hasn't settled by this many ms (an unresponsive
#                                        # worker), the pre-warm gives up and reports itself
#                                        # finished anyway — GET /ready flips to 200 rather than
#                                        # staying 503 forever for a process that is in fact
#                                        # serving every request correctly (the pool falls back
#                                        # in-process); GET /health's doctorPool.timedOut records
#                                        # that this is what happened. Default 30000 is
#                                        # comfortably above the measured warm-up
#                                        # (warmDoctorPool()'s own doc comment,
#                                        # server/nvm/analyze/doctor-pool.ts: "~2.1–2.7 s on
#                                        # an idle box, up to ~3.9 s under load (measured
#                                        # 2026-09-04/05)").

# ── Session backups (all optional) ───────────────────────────────────────────
# BACKUP_INTERVAL_HOURS=6                # Run the same backup logic as `npm run backup` on an
#                                        # in-process timer. OFF by default (unset = no timer,
#                                        # no backup/ directory created). PERSIST mode only.
# BACKUP_DIR=backup                      # Destination root for snapshot subdirectories
#                                        # (default: ./backup). Shared by the timer and the CLI.
# BACKUP_RETENTION_DAYS=14               # Prune snapshot subdirectories older than N days (off by default)
# BACKUP_RETENTION_KEEP=20               # Keep at most N snapshot subdirectories (off by default)
# SESSION_BACKUP_DIR=data/backups/session-resets
#                                        # Where POST /api/reset publishes its pre-reset recovery
#                                        # artifact (default: ./data/backups/session-resets).
# SESSION_RESET_BACKUP_KEEP=5            # Reset recovery artifacts retained per session (default: 5)
# SESSION_RESET_BACKUP_TTL_HOURS=168     # Hours a reset recovery artifact is retained (default: 168 = 7 days)

# ── Local browser-verification tooling (optional — read only by scripts/lib/
# browser-verify.mjs's getTiming(), never by the server process itself) ──────
# VERIFY_MAX_LOAD_PER_CPU=2              # Refuse to even start a browser-verify suite when
#                                        # os.loadavg()[0]/os.cpus().length exceeds this (exit
#                                        # code 3, load named in the message, no server boot or
#                                        # Chromium launch) instead of scaling timeouts up to the
#                                        # normal 4.0x cap. Unset (default): never refuses —
#                                        # scaling is the whole story (see README.md's "Timing
#                                        # under load" section and CONTRIBUTING.md).
