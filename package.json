{
  "name": "storymachine",
  "private": true,
  "version": "1.0.0-rc.1",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 || >=24"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:metamorphic": "node --experimental-strip-types evals/scoring/runner/run-metamorphic.ts",
    "rulebook": "node --experimental-strip-types scripts/generate-rulebook.ts",
    "generate-p0-sample": "node --experimental-strip-types scripts/generate-p0-sample-report.ts",
    "measure-slop": "node --experimental-strip-types scripts/measure-slop-discrimination.ts",
    "measure-real": "node --experimental-strip-types scripts/measure-real-script-discrimination.ts",
    "honesty-audit": "node scripts/honesty-audit.mjs",
    "discharge-obligations": "node scripts/discharge-obligations.mjs",
    "check-scoring-receipt": "node scripts/check-scoring-receipt.mjs",
    "check-no-console": "node scripts/check-no-console.mjs",
    "backup": "node --experimental-strip-types scripts/backup-sessions.ts",
    "restore-session": "node --experimental-strip-types scripts/restore-session.ts",
    "check-docs": "node --experimental-strip-types scripts/check-docs-quality.ts --all",
    "check-docs:strict": "node --experimental-strip-types scripts/check-docs-quality.ts --all --strict",
    "setup-hooks": "cp scripts/pre-commit.sh .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit && echo '✓ Git hooks installed'",
    "validate": "npm run lint && npm run check-docs && npm test",
    "gates": "node scripts/report-unverified-gates.mjs",
    "verify:surfaces": "node scripts/verify-p2-p3-surfaces.mjs",
    "verify:focus-traps": "node scripts/verify-focus-traps.mjs",
    "verify:p0-flow": "node scripts/smoke-p0-live-flow.mjs",
    "verify:ui-polish": "node scripts/verify-ui-polish-affordances.mjs",
    "verify:local-safety-net": "node scripts/verify-e4-local-safety-net.mjs",
    "verify:command-palette": "node scripts/verify-e5-command-palette.mjs",
    "verify:corpus-layout": "node scripts/verify-corpus-layout.mjs",
    "verify:llm-providers": "node scripts/smoke-llm-providers.mjs",
    "verify:browser": "npm run verify:p0-flow && npm run verify:focus-traps && npm run verify:surfaces"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "undici": "^8.9.0",
    "ws": "^8.21.0",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.11",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
