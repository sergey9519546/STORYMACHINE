# Understand-Anything analysis artifacts (knowledge graph, fingerprints,
# scan intermediates). Generated by /understand — re-generable on demand.
.ua/

# graphify tool output: standalone corpus graph from a separate tooling run
# (not produced or consumed by the STORYMACHINE app code). Regenerable cache.
graphify-out/
*.log
.env*
!.env.example
*.wav
.claude/
.zcode/
.playwright-cli/
output/playwright/**
!output/playwright/whole_site_qa.py
docs/user-validation/sessions/
data/

# The `data/` rule above is for the root runtime dir (per-visitor SQLite
# session DBs, gitignored for good reason). But it also matches any nested
# `data/` dir by name — including `server/nvm/analyze/data/`, which holds a
# required runtime asset: the emotional-arc lexicon read synchronously via
# readFileSync at module-import time in emotional-arc.ts / inflection-tension.ts
# / theme-extract.ts. Without it, CI's clean checkout throws ENOENT on import
# and 38 server/analyzer/export tests fail. Re-include that one dir explicitly.
!server/nvm/analyze/data/
!server/nvm/analyze/data/**

# corpus-crosswalk.json (scripts/migrate-corpus-ids.mjs's output): maps
# de-identified SM-<hash> corpus ids back to the private corpus's original
# paths/titles for the maintainer's own local audit. MUST NEVER be committed
# -- that would re-enumerate every title the id scheme exists to hide. The
# generator itself refuses to write into a tracked location (git check-ignore
# gate), and this pattern is the belt to that suspenders. See
# docs/p1-benchmark/CORPUS_IDENTIFICATION.md.
corpus-crosswalk.json
corpus-crosswalk*.json
corpus-crosswalk*

# Captured test-run output (2.5MB of console noise, regenerable via `npm test`).
# Was tracked by accident; it also echoed corpus filenames into git.
test_results.txt

