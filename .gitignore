node_modules/
build/
dist/
coverage/
.DS_Store

# Understand-Anything analysis artifacts (knowledge graph, fingerprints,
# scan intermediates). Generated by /understand — re-generable on demand.
.ua/

# graphify tool output: standalone corpus graph from a separate tooling run
# (not produced or consumed by the STORYMACHINE app code). Regenerable cache.
graphify-out/
*.log
.env*
!.env.example
*.wav
.claude/
.zcode/
.playwright-cli/
output/playwright/**
!output/playwright/whole_site_qa.py
# docs/user-validation/sessions/: privacy-reviewed session markdown records
# ARE committable (P0_OPERATING_KIT.md's post-session handling requires
# filing the final, redacted record at sessions/P0-00N.md) -- everything
# else in this directory (raw exports, recordings, transcripts, and other
# PII-bearing artifacts) stays excluded by default. See
# FIRST_SESSION_QUICKSTART.md "Commit rules" for the flow this unblocks.
docs/user-validation/sessions/*
!docs/user-validation/sessions/*.md
!docs/user-validation/sessions/.gitkeep
docs/user-validation/sessions/*.mp3
docs/user-validation/sessions/*.mp4
docs/user-validation/sessions/*.wav
docs/user-validation/sessions/*.m4a
docs/user-validation/sessions/*.txt
docs/user-validation/sessions/*.json
docs/user-validation/sessions/*.csv
docs/user-validation/sessions/*.pdf
docs/user-validation/sessions/*.docx
data/

# The `data/` rule above is for the root runtime dir (per-visitor SQLite
# session DBs, gitignored for good reason). But it also matches any nested
# `data/` dir by name — including `server/nvm/analyze/data/`, which holds a
# required runtime asset: the emotional-arc lexicon read synchronously via
# readFileSync at module-import time in emotional-arc.ts / inflection-tension.ts
# / theme-extract.ts. Without it, CI's clean checkout throws ENOENT on import
# and 38 server/analyzer/export tests fail. Re-include that one dir explicitly.
!server/nvm/analyze/data/
!server/nvm/analyze/data/**

# corpus-crosswalk.json (scripts/migrate-corpus-ids.mjs's output): maps
# de-identified SM-<hash> corpus ids back to the private corpus's original
# paths/titles for the maintainer's own local audit. MUST NEVER be committed
# -- that would re-enumerate every title the id scheme exists to hide. The
# generator itself refuses to write into a tracked location (git check-ignore
# gate), and this pattern is the belt to that suspenders. See
# docs/p1-benchmark/CORPUS_IDENTIFICATION.md.
corpus-crosswalk.json
corpus-crosswalk*.json
corpus-crosswalk*

# Captured test-run output (2.5MB of console noise, regenerable via `npm test`).
# Was tracked by accident; it also echoed corpus filenames into git.
test_results.txt

# Captured `tsc --noEmit` output from the quarantined v5.0 kernel era (2026-07-23).
# Both test files it cites errors for (server/engine/ai-provider.test.ts,
# server/engine/ai-provider-integration.test.ts) no longer exist, and
# `npm run lint` is currently clean (0 errors) -- this file was tracked by
# accident and is actively misleading if read as current lint output.
# 2026-08-03 hygiene audit.
tsc_errors.txt

# screenplay-training/ — local-only model training corpus (~269MB of
# screenplay text + training blueprints). Not referenced by the app code,
# not produced or consumed by any build/test path. Gitignored to prevent
# an accidental mass-commit of copyrighted screenplay text. If this dir
# is needed for a future training pipeline, track it via LFS or a separate
# data repo, not as a regular git tree.
screenplay-training/

# Browser-proof screenshots regenerated by every scripts/verify-*.mjs run.
# The measurement JSON/CSV artifacts in scripts/output/ ARE tracked (they
# back receipts and evidence docs); the PNGs are per-run local proof only —
# every lane to date has deliberately left them uncommitted, and committing
# binaries that change on each run would bloat history for no evidence value.
scripts/output/*.png
